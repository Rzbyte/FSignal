# ---------------------------------------------------------------------------
# Persistence and scheduler
# ---------------------------------------------------------------------------
DATABASE_PATH=data/ghost_radar.db
STARTUP_SCAN=true
REQUEST_TIMEOUT_SECONDS=25
USER_AGENT="FSignal/1.2 (+launch-monitor)"

# Per-source polling intervals (minutes). Each source runs independently with
# adaptive backoff. This is polling, not webhooks.
#
# The social sources cost search credits and the directories do not, so they are
# paced differently. A social scan spends about one credit per active batch; at
# a ten-minute interval that is >1,000 credits/day and a free search plan is
# gone in two days. Four hours costs about 70/day. Lower these only if you are
# on a paid search plan and watching the balance.
X_SCAN_INTERVAL_MINUTES=240
LINKEDIN_SCAN_INTERVAL_MINUTES=240
# Free to poll, and both new-listing alerts and Ghost -> Confirmed
# reconciliation are only as timely as these are.
YC_SCAN_INTERVAL_MINUTES=60
SPEEDRUN_SCAN_INTERVAL_MINUTES=120
GHOST_RECHECK_INTERVAL_MINUTES=30

# ---------------------------------------------------------------------------
# YC Directory (public Algolia application behind ycombinator.com/companies)
# ---------------------------------------------------------------------------
YC_DIRECTORY_URL=https://www.ycombinator.com/companies
# The launch-date replica sorts newest-listed first, which is what a launch
# monitor needs. The relevance index is a fallback only.
YC_INDEX_NAME=YCCompany_By_Launch_Date_production
YC_FALLBACK_INDEX_NAME=YCCompany_production
# A full facet-sliced crawl reads every batch (~6.2k companies, ~8s). Between
# crawls a single recent-window query catches new listings.
YC_FULL_CRAWL_INTERVAL_MINUTES=720
# How many currently-filling batches/cohorts to hunt on social.
ACTIVE_BATCH_COUNT=2
# An EARLY verdict is only defensible against a snapshot at least this fresh.
SNAPSHOT_MAX_AGE_MINUTES=60

# ---------------------------------------------------------------------------
# Speedrun (a16z). speedrun.a16z.com/companies calls this API itself, so it is
# the canonical client-facing path, not a mirror.
# ---------------------------------------------------------------------------
SPEEDRUN_URL=https://speedrun.a16z.com/companies
SPEEDRUN_API_URL=https://speedrun-api.a16z.com/api/companies/companies/?limit=500
# Resilience only. Runs that use it are labelled `fallback`.
SPEEDRUN_FALLBACK_URL=https://speedrun-talent-network.com/collections/speedrun-companies

# ---------------------------------------------------------------------------
# X. Optional. X's own recent search requires a paid tier; without a token, or
# on a depleted account, the X source falls back to indexed public search using
# SERPER_API_KEY below, and every alert says which path it came from.
# ---------------------------------------------------------------------------
X_BEARER_TOKEN=
X_MAX_RESULTS=50

# ---------------------------------------------------------------------------
# Search provider. This one key powers both LinkedIn discovery and the X
# fallback, so with Slack it is enough to run the whole bot.
# Note: the free tier rejects num > 10.
# ---------------------------------------------------------------------------
# >>> REQUIRED <<<  Get a free key at https://serper.dev
SERPER_API_KEY=
LINKEDIN_LOOKBACK=w   # d=day, w=week, m=month
X_INDEXED_LOOKBACK=m  # X status URLs are indexed with a longer lag than LinkedIn
# Below this confidence a candidate is recorded as "possible" and never alerted.
MIN_SIGNAL_CONFIDENCE=60
GTM_HIGH_PRIORITY_THRESHOLD=80

# ---------------------------------------------------------------------------
# Slack (single-workspace personal app). See docs/INSTALL.md for the click path.
# This file is gitignored -- keep it that way, and never paste a token anywhere
# else in the repo.
# ---------------------------------------------------------------------------
# >>> REQUIRED <<<  xoxb-... from your Slack app's OAuth & Permissions page
SLACK_BOT_TOKEN=
# >>> REQUIRED <<<  C... for a channel, D... for a DM
SLACK_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Pond Protocol V1. Optional -- only needed to publish the agent on Pond.
# ---------------------------------------------------------------------------
POND_ACCESS_KEY=
PUBLIC_BASE_URL=https://your-deployment.example.com

# Keep false for a real deployment. The replay script sets it itself.
DEMO_MODE=false
