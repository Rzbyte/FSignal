# ---------------------------------------------------------------------------
# Persistence and scheduler
# ---------------------------------------------------------------------------
DATABASE_PATH=data/ghost_radar.db
STARTUP_SCAN=true
REQUEST_TIMEOUT_SECONDS=25
USER_AGENT="FSignal/1.2 (+launch-monitor)"

# Per-source polling intervals (minutes). Each source runs independently with
# adaptive backoff. This is near-real-time polling, not webhooks.
X_SCAN_INTERVAL_MINUTES=10
LINKEDIN_SCAN_INTERVAL_MINUTES=15
YC_SCAN_INTERVAL_MINUTES=20
SPEEDRUN_SCAN_INTERVAL_MINUTES=30
GHOST_RECHECK_INTERVAL_MINUTES=10

# ---------------------------------------------------------------------------
# YC Directory (public Algolia application behind ycombinator.com/companies)
# ---------------------------------------------------------------------------
YC_DIRECTORY_URL=https://www.ycombinator.com/companies
# The launch-date replica sorts newest-listed first, which is what a launch
# monitor needs. The relevance index is a fallback only.
YC_INDEX_NAME=YCCompany_By_Launch_Date_production
YC_FALLBACK_INDEX_NAME=YCCompany_production
# A full facet-sliced crawl reads every batch (~6.2k companies, ~8s). Between
# crawls a single recent-window query catches new listings.
YC_FULL_CRAWL_INTERVAL_MINUTES=720
# How many currently-filling batches/cohorts to hunt on social.
ACTIVE_BATCH_COUNT=2
# An EARLY verdict is only defensible against a snapshot at least this fresh.
SNAPSHOT_MAX_AGE_MINUTES=60

# ---------------------------------------------------------------------------
# Speedrun (a16z). speedrun.a16z.com/companies calls this API itself, so it is
# the canonical client-facing path, not a mirror.
# ---------------------------------------------------------------------------
SPEEDRUN_URL=https://speedrun.a16z.com/companies
SPEEDRUN_API_URL=https://speedrun-api.a16z.com/api/companies/companies/?limit=500
# Resilience only. Runs that use it are labelled `fallback`.
SPEEDRUN_FALLBACK_URL=https://speedrun-talent-network.com/collections/speedrun-companies

# ---------------------------------------------------------------------------
# X recent search. Requires a paid tier; the free tier has no recent search.
# ---------------------------------------------------------------------------
X_BEARER_TOKEN=
X_MAX_RESULTS=50

# ---------------------------------------------------------------------------
# Public LinkedIn discovery via an indexed-search provider.
# Note: Serper's free tier rejects num > 10.
# ---------------------------------------------------------------------------
SERPER_API_KEY=
LINKEDIN_LOOKBACK=d
# Below this confidence a candidate is recorded as "possible" and never alerted.
MIN_SIGNAL_CONFIDENCE=60
GTM_HIGH_PRIORITY_THRESHOLD=80

# ---------------------------------------------------------------------------
# Slack (single-workspace personal app)
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Pond Protocol V1
# ---------------------------------------------------------------------------
POND_ACCESS_KEY=
PUBLIC_BASE_URL=https://your-deployment.example.com

# Keep false for a real deployment. The replay script sets it itself.
DEMO_MODE=false
